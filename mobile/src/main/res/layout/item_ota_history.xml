<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="6dp"
    app:cardCornerRadius="10dp"
    app:cardElevation="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tv_item_timestamp"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="14sp"
                android:textColor="#888888"
                tools:text="2026-09-11 14:32:10" />

            <ImageView
                android:id="@+id/iv_item_result"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginEnd="6dp"
                tools:src="@drawable/ic_circle_green" />

            <TextView
                android:id="@+id/tv_item_result"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="14sp"
                android:textStyle="bold"
                tools:text="Réussite" />

        </LinearLayout>

        <TextView
            android:id="@+id/tv_item_product"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/silabs_black"
            tools:text="SIN-4-2-20 — Antenne" />

        <TextView
            android:id="@+id/tv_item_batch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textSize="14sp"
            android:textColor="#555555"
            tools:text="N° de production : OAR260090" />

        <TextView
            android:id="@+id/tv_item_versions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textSize="13sp"
            android:textColor="#888888"
            tools:text="Modèle : SIN-4-2-20 · Antenne : 3.13.0 · Puissance : 3.1.5 · MAC : AA:BB:CC:DD:EE:FF" />

        <TextView
            android:id="@+id/tv_item_failure_reason"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textSize="13sp"
            android:textColor="@color/silabs_red"
            android:visibility="gone"
            tools:text="Post-OTA verify mismatch: model=SIN-4-2-20_PRO/SIN-4-2-20"
            tools:visibility="visible" />

    </LinearLayout>

</androidx.cardview.widget.CardView>
